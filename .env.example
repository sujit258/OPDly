# OPDly Environment Configuration
# Production Domain: https://opdly.suvidhatools.in

NODE_ENV=development
FRONTEND_ORIGIN=https://opdly.suvidhatools.in

# Neon PostgreSQL Connection URL
# Replace with your production Neon PostgreSQL connection string:
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/opdly?sslmode=require"

# Session & Security Secret
SESSION_SECRET="opdly_production_secret_key_change_me"

# Frontend Repository Mode:
# 'local'  -> Uses browser IndexedDB / demo repository (default for dev/demo)
# 'remote' -> Uses production Vercel Serverless /api/v1 endpoints with PostgreSQL
VITE_API_MODE=local
